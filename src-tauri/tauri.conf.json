{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ECHO Knowledge",
  "version": "1.1.0",
  "identifier": "com.echo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ECHO Knowledge",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ECHO Knowledge",
    "homepage": "https://github.com/dharunram-lgtm/Echo_Knowledge",
    "category": "Productivity",
    "shortDescription": "Local-first personal AI knowledge system",
    "longDescription": "ECHO Knowledge stores your documents and knowledge base locally, with optional direct connections to Gemini and Groq for embeddings and grounded answers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "ECHO Knowledge",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
